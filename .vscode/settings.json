\) \\{\n  if \\(!content\\.startsWith\\('---\\\\n'\\)\\) return null;\n  const end = content\\.indexOf\\('\\\\n---\\\\n', 4\\);\n  if \\(end === -1\\) return null;\n  return \\{\n    raw: content\\.slice\\(4, end\\),\n    body: content\\.slice\\(end \\+ 5\\),\n  \\};\n\\}\n\nfunction parseExcerptOrDescription\\(raw, key\\) \\{\n  const lines = raw\\.split\\('\\\\n'\\);\n  for \\(let i = 0; i < lines\\.length; i\\+\\+\\) \\{\n    const m = lines\\[i\\]\\.match\\(new RegExp\\(`\\^\\$\\{key\\}:\\\\\\\\s\\*\\(\\.\\*\\)\\$`\\)\\);\n    if \\(!m\\) continue;\n    const rest = m\\[1\\] \\|\\| '';\n    if \\(!rest \\|\\| rest\\.trim\\(\\) === '' \\|\\| rest\\.trim\\(\\) === '\\|'\\) \\{\n      const vals = \\[\\];\n      for \\(let j = i \\+ 1; j < lines\\.length; j\\+\\+\\) \\{\n        if \\(/\\^\\\\S/\\.test\\(lines\\[j\\]\\)\\) break;\n        if \\(/\\^\\\\s\\{2,\\}/\\.test\\(lines\\[j\\]\\)\\) vals\\.push\\(lines\\[j\\]\\.replace\\(/\\^\\\\s\\{2\\}/, ''\\)\\);\n        else break;\n      \\}\n      return vals\\.join\\(' '\\)\\.trim\\(\\);\n    \\}\n    if \\(rest\\.trim\\(\\) === '>-'\\) \\{\n      const vals = \\[\\];\n      for \\(let j = i \\+ 1; j < lines\\.length; j\\+\\+\\) \\{\n        if \\(/\\^\\\\S/\\.test\\(lines\\[j\\]\\)\\) break;\n        if \\(/\\^\\\\s\\{2,\\}/\\.test\\(lines\\[j\\]\\)\\) vals\\.push\\(lines\\[j\\]\\.replace\\(/\\^\\\\s\\{2\\}/, ''\\)\\);\n        else break;\n      \\}\n      return vals\\.join\\(' '\\)\\.trim\\(\\);\n    \\}\n    return stripQuotes\\(rest\\)\\.trim\\(\\);\n  \\}\n  return '';\n\\}\n\nfunction parseLineField\\(raw, key\\) \\{\n  const m = raw\\.match\\(new RegExp\\(`\\^\\$\\{key\\}:\\\\\\\\s\\*\\(\\.\\+\\)\\$`, 'm'\\)\\);\n  return m \\? m\\[1\\]\\.trim\\(\\) : '';\n\\}\n\nfunction expectedTitle\\(filePath\\) \\{\n  const base = path\\.basename\\(filePath, '\\.md'\\);\n  const tokenSource = base === 'index' \\? path\\.basename\\(path\\.dirname\\(filePath\\)\\) : base;\n  return tokenSource\n    \\.split\\('-'\\)\n    \\.filter\\(Boolean\\)\n    \\.map\\(\\(w\\) => w\\.charAt\\(0\\)\\.toUpperCase\\(\\) \\+ w\\.slice\\(1\\)\\.toLowerCase\\(\\)\\)\n    \\.join\\(' '\\);\n\\}\n\nfunction isMeaningfulDescription\\(s\\) \\{\n  if \\(!s\\) return false;\n  const t = s\\.trim\\(\\);\n  if \\(!t\\) return false;\n  return /\\[A-Za-z0-9\\]/\\.test\\(t\\);\n\\}\n\nfunction imageTagToImg\\(tag\\) \\{\n  const src = \\(tag\\.match\\(/\\\\bsrc=\"\\(\\[\\^\"\\]\\+\\)\"/\\) \\|\\| \\[\\]\\)\\[1\\] \\|\\| '';\n  const align = \\(\\(tag\\.match\\(/\\\\balign=\"\\(\\[\\^\"\\]\\+\\)\"/\\) \\|\\| \\[\\]\\)\\[1\\] \\|\\| ''\\)\\.toLowerCase\\(\\);\n  const alt = \\(tag\\.match\\(/\\\\balt=\"\\(\\[\\^\"\\]\\*\\)\"/\\) \\|\\| \\[\\]\\)\\[1\\] \\|\\| \\(tag\\.match\\(/\\\\bcaption=\"\\(\\[\\^\"\\]\\*\\)\"/\\) \\|\\| \\[\\]\\)\\[1\\] \\|\\| '';\n  const mappedSrc = imageMap\\.get\\(src\\) \\|\\| src;\n  if \\(align === 'right'\\) \\{\n    return `<img src=\"\\$\\{mappedSrc\\}\" alt=\"\\$\\{alt\\}\" className=\"float-right ml-4 mb-1 mt-0 rounded-lg object-cover\" />`;\n  \\}\n  if \\(align === 'left'\\) \\{\n    return `<img src=\"\\$\\{mappedSrc\\}\" alt=\"\\$\\{alt\\}\" className=\"float-left mr-4 mb-1 mt-0 rounded-lg object-cover\" />`;\n  \\}\n  return `<img src=\"\\$\\{mappedSrc\\}\" alt=\"\\$\\{alt\\}\" className=\"mx-auto block rounded-lg object-cover\" style=\\{\\{ width: \\\\\"80%\\\\\" \\}\\} />`;\n\\}\n\nfunction normalizeClosingTagSpacing\\(content\\) \\{\n  const lines = content\\.split\\('\\\\n'\\);\n  const out = \\[\\];\n  const closers = new Set\\(\\['</Note>', '</Tip>', '</Warning>', '</Tab>', '</Tabs>', '</Table>', '</CardGroup>', '</Card>', '</a>'\\]\\);\n  for \\(let i = 0; i < lines\\.length; i\\+\\+\\) \\{\n    let line = lines\\[i\\];\n    const trimmed = line\\.trim\\(\\);\n    if \\(closers\\.has\\(trimmed\\)\\) \\{\n      line = trimmed;\n      const prev = out\\.length \\? out\\[out\\.length - 1\\] : '';\n      if \\(/\\^\\\\s\\*\\(\\?:\\[-\\*\\]\\\\s\\+\\|\\\\d\\+\\\\\\.\\\\s