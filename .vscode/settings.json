ported Callout theme \\$\\{theme\\}`\\);\n      mapped = null;\n    \\}\n    if \\(!mapped\\) return tag;\n    stack\\.push\\(mapped\\);\n    return `<\\$\\{mapped\\}>`;\n  \\}\\);\n\n  content = content\\.replace\\(/<Image\\\\b\\[\\^>\\]\\*\\\\/>/g, \\(tag\\) => imageTagToImg\\(tag\\)\\);\n\n  content = content\\.replace\\(/!\\\\\\[\\(\\[\\^\\\\\\]\\]\\*\\)\\\\\\]\\\\\\(\\(https\\?:\\\\/\\\\/\\[\\^\\)\\]\\+\\)\\\\\\)/g, \\(m, alt, src\\) => \\{\n    const mapped = imageMap\\.get\\(src\\);\n    if \\(!mapped\\) return m;\n    return `<img src=\"\\$\\{mapped\\}\" alt=\"\\$\\{alt \\|\\| ''\\}\" className=\"mx-auto block rounded-lg object-cover\" style=\\{\\{ width: \\\\\"80%\\\\\" \\}\\} />`;\n  \\}\\);\n\n  content = content\\.replace\\(/<\\\\/\\?Anchor\\\\b/g, \\(m\\) => \\(m\\.startsWith\\('</'\\) \\? '</a' : '<a'\\)\\);\n\n  content = content\n    \\.split\\('\\\\n'\\)\n    \\.filter\\(\\(line\\) => !/\\^\\\\s\\*>\\?\\\\s\\*<br\\\\s\\*\\\\/\\?>\\\\s\\*\\$/\\.test\\(line\\)\\)\n    \\.join\\('\\\\n'\\);\n\n  content = normalizeClosingTagSpacing\\(content\\);\n  content = content\\.replace\\(/\\\\n\\{3,\\}/g, '\\\\n\\\\n'\\)\\.replace\\(/\\\\s\\+\\$/g, ''\\) \\+ '\\\\n';\n\n  fs\\.writeFileSync\\(file, content, 'utf8'\\);\n\\}\n\nif \\(unsupported\\.length\\) \\{\n  console\\.error\\('UNSUPPORTED_ELEMENTS_FOUND'\\);\n  for \\(const row of unsupported\\) console\\.error\\(row\\);\n  process\\.exit\\(2\\);\n\\}\n\nconsole\\.log\\('Migration script applied successfully\\.'\\);\nNODE$/": {
